        "sqlQuery": "WITH top_users AS (\n  SELECT createdby\n  FROM audit\n  WHERE createdat >= '${startDate}'::timestamp\n    AND createdat < ('${endDate}'::date + INTERVAL '1 day')\n  GROUP BY createdby\n  ORDER BY COUNT(*) DESC\n  LIMIT 5\n)\n\nSELECT\n  DATE(a.createdat) AS period,\n  a.createdby AS username,\n  COUNT(*) AS audit_count\nFROM audit a\nJOIN top_users tu ON a.createdby = tu.createdby\nWHERE a.createdat >= '${startDate}'::timestamp\n  AND a.createdat < ('${endDate}'::date + INTERVAL '1 day')\nGROUP BY period, a.createdby\nORDER BY period ASC, audit_count DESC;",
        "type": "QUERY",
