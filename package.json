{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "1.8.2",
  "scripts": {
    "start": "d2-app-scripts start",
    "test": "d2-app-scripts test",
    "deploy": "d2-app-scripts deploy",
    "build": "d2-app-scripts build --no-verify",
    "dev": "vite",
    "release": "standard-version"
  },
  "standard-version": {
    "types": [
      {
        "type": "feat",
        "section": "✨ New Features"
      },
      {
        "type": "fix",
        "section": "🐛 Bug Fixes"
      },
      {
        "type": "chore",
        "section": "🔧 Technical Tasks"
      },
      {
        "type": "docs",
        "section": "📝 Documentation"
      },
      {
        "type": "style",
        "section": "💄 Styling"
      },
      {
        "type": "refactor",
        "section": "♻️ Code Refactoring"
      },
      {
        "type": "perf",
        "section": "⚡ Performance Improvements"
      },
      {
        "type": "test",
        "section": "✅ Testing"
      },
      {
        "type": "ci",
        "section": "🚀 CI/CD"
      }
    ],
    "header": "# Changelog\n\nAll notable changes to DHIS2 Audit Vision will be documented in this file.\n"
  },
  "dependencies": {
    "@dhis2/data-engine": "^3.17.0",
    "@tailwindcss/postcss": "^4.1.18",
    "axios": "^1.15.2",
    "classnames": "^2.5.1",
    "clsx": "2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1",
    "recoil": "^0.7.7",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@dhis2/app-adapter": "12.6.0",
    "@dhis2/app-runtime": "^3.13.0",
    "@dhis2/cli-app-scripts": "12.9.2",
    "@dhis2/d2-i18n": "^1.1.3",
    "@dhis2/ui": "^10.7.2",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.1.1",
    "standard-version": "^9.5.0",
    "tailwindcss": "4.1.17",
